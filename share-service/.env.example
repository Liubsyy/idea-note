ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_ORIGIN=http://localhost:8787
ALLOWED_ORIGINS=
# Number of reverse proxies in front of the service. Docker Compose defaults to 1;
# set 0 if the port is reachable without the proxy. Bare Node defaults to 0.
TRUST_PROXY=
DATA_DIR=./data
PORT=8787
# Node/Docker defaults to local disk. Set b2 to use a private Backblaze bucket.
OBJECT_STORAGE=local
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_PREFIX=idea-note-share/
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

{
  "name": "idea-note-share-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430",
    "build": "tsc --noEmit && vite build",
    "start": "node server/node.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:worker": "npm run build && wrangler deploy --dry-run --outdir .wrangler/test-worker && node scripts/worker-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "codemirror": "^6.0.2",
    "construct-style-sheets-polyfill": "^3.1.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.469.0",
    "markdown-it": "^14.3.3",
    "mermaid": "10.9.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "30.1.2",
    "miniflare": "^5.20261019.1-beta",
    "typescript": "~5.8.3",
    "vite": "^8.0.16",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  }
}
